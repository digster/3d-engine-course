# cube.obj — the unit cube, written the way a modelling tool writes it.
#
# Twenty readable lines that contain the whole index problem. Eight positions,
# four texture coordinates, six normals, six quad faces. Count the combinations
# a face corner names and you get 24 distinct (position, uv, normal) triples —
# so this eight-corner box becomes a 24-vertex mesh the moment it is loaded.
# Lesson 3.5 §3 works through exactly this file.
#
# Authored for "Build a Professional 3D Game Engine". MIT, like the rest of the
# repository. Wound counter-clockwise seen from outside, matching the cube in
# src/gfx/mesh.hpp vertex for vertex and triangle for triangle.

o cube

# ---- Positions -------------------------------------------------------------
# 1-based from here on: the first `v` below is index 1, not index 0.
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

# ---- Texture coordinates ---------------------------------------------------
# Four corners of the unit square, shared by all six faces: every face maps the
# whole texture. Note the separate numbering — vt 1 has nothing to do with v 1.
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# ---- Normals ---------------------------------------------------------------
# One per face, because a cube is faceted: the corner where three faces meet
# has three different normals, and that is what forces the vertex split.
vn  0.0  0.0 -1.0
vn  0.0  0.0  1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# ---- Faces -----------------------------------------------------------------
# Quads, not triangles — which is what tools export, and what a renderer has to
# triangulate. Each corner is position/uv/normal.
usemtl none
s off
g faces
f 1/1/1 4/4/1 3/3/1 2/2/1
f 5/1/2 6/2/2 7/3/2 8/4/2
f 1/1/3 5/2/3 8/3/3 4/4/3
f 2/1/4 3/4/4 7/3/4 6/2/4
f 4/1/5 8/2/5 7/3/5 3/4/5
f 1/1/6 2/2/6 6/3/6 5/4/6
